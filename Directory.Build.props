<Project>
  <!-- One version for every project and the installer (read by installer/build-installer.ps1). -->
  <PropertyGroup>
    <Version>1.0.3</Version>
    <Company>RTA Sound Monitor</Company>
    <Product>RTA Sound Monitor</Product>
    <!-- English-only UI: skip the framework's translated resource folders in published output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
