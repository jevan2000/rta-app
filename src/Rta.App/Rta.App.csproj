<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RtaApp</AssemblyName>
    <RootNamespace>Rta.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rta.Core\Rta.Core.csproj" />
    <ProjectReference Include="..\Rta.Audio\Rta.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <!-- Builds the React dashboard (web/) into wwwroot when it hasn't been built yet. Run `npm run build` in web/ after changing it. -->
  <Target Name="BuildDashboard" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html') And Exists('$(MSBuildProjectDirectory)\..\..\web\package.json')">
    <Message Importance="high" Text="Building the dashboard (web/)…" />
    <Exec Command="npm ci --no-fund --no-audit" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" Condition="!Exists('$(MSBuildProjectDirectory)\..\..\web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />
  </Target>

</Project>
